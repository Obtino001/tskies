{%- doc -%}
  Renders the Ring Size Chart Modal dialog.
{%- enddoc -%}

<div id="TskiesSizeChartModal" class="tskies-modal" role="dialog" aria-modal="true" aria-labelledby="SizeChartTitle" hidden>
  <div class="tskies-modal__overlay" data-modal-close></div>
  <div class="tskies-modal__content">
    <div class="tskies-modal__header">
      <h3 id="SizeChartTitle" class="tskies-modal__title">Ringstørrelsesguide</h3>
      <button type="button" class="tskies-modal__close" data-modal-close aria-label="{{ 'accessibility.close' | t | default: 'Luk' }}">
        <span class="svg-wrapper">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>
    <div class="tskies-modal__body">
      <p class="tskies-modal__intro">
        Brug denne guide til at finde din perfekte pasform. Hvis du er mellem to størrelser, anbefaler vi at vælge den største.
      </p>
      <div class="tskies-modal__table-wrap">
        <table class="tskies-size-table">
          <thead>
            <tr>
              <th>US-størrelse</th>
              <th>Indvendig omkreds (mm)</th>
              <th>Indvendig diameter (mm)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>5</td><td>49.3</td><td>15.7</td></tr>
            <tr><td>6</td><td>51.9</td><td>16.5</td></tr>
            <tr><td>7</td><td>54.4</td><td>17.3</td></tr>
            <tr><td>8</td><td>57.0</td><td>18.1</td></tr>
            <tr><td>9</td><td>59.5</td><td>18.9</td></tr>
            <tr><td>10</td><td>62.1</td><td>19.8</td></tr>
            <tr><td>11</td><td>64.6</td><td>20.6</td></tr>
            <tr><td>12</td><td>67.2</td><td>21.4</td></tr>
            <tr><td>13</td><td>69.7</td><td>22.2</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
