{%- doc -%}
  Renders payment method icons using Shopify's built-in payment icons.

  @param {string} [types] - Optional comma-separated payment type handles. When blank, the "Payment icons" theme setting is used, and when that is blank too, the payment methods enabled for the store are shown.
  @param {string} [alignment] - `center` or `start`. Defaults to `center`.

  @example
  {% render 'payment-icons' %}
{%- enddoc -%}
{%- liquid
  assign configured_types = types | default: settings.payment_icon_types
  if configured_types != blank
    assign payment_types = configured_types | remove: ' ' | split: ','
  else
    assign payment_types = shop.enabled_payment_types
  endif
-%}
{%- if payment_types.size > 0 -%}
  <ul
    class="list list-payment tskies-payment-icons tskies-payment-icons--{{ alignment | default: 'center' }}{% if settings.payment_icon_greyscale %} tskies-payment-icons--greyscale{% endif %}"
    role="list"
  >
    {%- for type in payment_types -%}
      {%- assign payment_svg = type | payment_type_svg_tag: class: 'icon icon--full-color' -%}
      {%- if payment_svg != blank -%}
        <li class="list-payment__item">{{ payment_svg }}</li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
