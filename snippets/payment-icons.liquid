{%- doc -%}
  Renders payment method icons using Shopify's built-in payment icons.

  @param {string} [types] - Comma-separated payment type handles (for example `visa, master, paypal`). When blank, the payment methods enabled for the store are shown.
  @param {boolean} [greyscale] - Whether to render the icons in greyscale. Defaults to false.
  @param {string} [alignment] - `center` or `start`. Defaults to `center`.

  @example
  {% render 'payment-icons', types: 'visa, master, paypal', greyscale: true %}
{%- enddoc -%}
{%- liquid
  if types != blank
    assign payment_types = types | remove: ' ' | split: ','
  else
    assign payment_types = shop.enabled_payment_types
  endif
-%}
{%- if payment_types.size > 0 -%}
  <ul
    class="list list-payment tskies-payment-icons tskies-payment-icons--{{ alignment | default: 'center' }}{% if greyscale %} tskies-payment-icons--greyscale{% endif %}"
    role="list"
  >
    {%- for type in payment_types -%}
      {%- assign payment_svg = type | payment_type_svg_tag: class: 'icon icon--full-color' -%}
      {%- if payment_svg != blank -%}
        <li class="list-payment__item">{{ payment_svg }}</li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
