{%- doc -%}
  Renders the header promo tiles configured for one top-level menu item.

  @param {string} parent_title - Title of the top-level menu item the tiles belong to. Matched case-insensitively against each tile's "Menu item" setting.
  @param {string} [context] - `mega` (desktop mega menu, default) or `drawer` (mobile menu drawer).

  @example
  {% render 'header-promo-tiles', parent_title: link.title, context: 'mega' %}
{%- enddoc -%}
{%- assign tile_context = context | default: 'mega' -%}
{%- assign parent_key = parent_title | downcase | strip -%}
{%- capture tiles_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'promo_tile' and block.settings.menu_item != blank -%}
      {%- assign tile_key = block.settings.menu_item | downcase | strip -%}
      {%- assign matches_parent = false -%}
      {%- if tile_key == parent_key or parent_key contains tile_key or tile_key contains parent_key -%}
        {%- assign matches_parent = true -%}
      {%- elsif parent_key == 'shop alt' and tile_key contains 'shop' -%}
        {%- assign matches_parent = true -%}
      {%- elsif parent_key == 'kollektioner' and tile_key contains 'collect' -%}
        {%- assign matches_parent = true -%}
      {%- elsif parent_key == 'galleri' and tile_key contains 'galler' -%}
        {%- assign matches_parent = true -%}
      {%- endif -%}
      {%- if matches_parent -%}
        {%- assign tile_link = block.settings.link | default: routes.collections_url -%}
        {%- assign tile_heading = block.settings.heading -%}
        <li class="header-promo-tile" {{ block.shopify_attributes }}>
          <a href="{{ tile_link }}" class="header-promo-tile__link link link--text focus-inset">
            <span class="header-promo-tile__media">
              {%- if block.settings.image != blank and block.settings.image.width > 0 -%}
                {{
                  block.settings.image
                  | image_url: width: 480
                  | image_tag: loading: 'lazy', widths: '240, 360, 480', sizes: '(min-width: 990px) 16vw, 40vw', alt: block.settings.image.alt | default: tile_heading
                }}
              {%- else -%}
                {%- assign heading_clean = tile_heading | downcase | strip -%}
                {%- capture promo_asset -%}
                  {%- case heading_clean -%}
                    {%- when 'ring stacks', 'ring-stakke' -%}megamenu_ring_stacks.png
                    {%- when 'jewelry sets', 'smykkesæt' -%}megamenu_jewelry_sets.jpg
                    {%- when 'enchantment' -%}megamenu_enchantment.png
                    {%- when 'radiante' -%}megamenu_radiante.png
                    {%- when 'fresh off the bench', 'frisk fra værkstedet' -%}megamenu_fresh_off_bench.png
                    {%- when 'one of a kind jewelry', 'unikke smykker' -%}megamenu_one_of_a_kind.jpg
                  {%- endcase -%}
                {%- endcapture -%}
                {%- assign promo_asset = promo_asset | strip -%}
                {%- if promo_asset != blank -%}
                  <img
                    src="{{ promo_asset | asset_url }}"
                    alt="{{ tile_heading | escape }}"
                    loading="lazy"
                    width="480"
                    height="480"
                    style="width: 100%; height: 100%; object-fit: cover;"
                  >
                {%- endif -%}
              {%- endif -%}
            </span>
            {%- if tile_heading != blank -%}
              <span class="header-promo-tile__heading">{{ tile_heading | escape }}</span>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <span class="header-promo-tile__button">{{ block.settings.button_label | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if tiles_html contains 'header-promo-tile' -%}
  <ul class="header-promo-tiles header-promo-tiles--{{ tile_context }} list-unstyled" role="list">
    {{ tiles_html }}
  </ul>
{%- endif -%}
