{%- style -%}
  .tskies-newsletter-{{ section.id }} { padding: {{ section.settings.padding_top | times: 0.75 | round }}px 0 {{ section.settings.padding_bottom | times: 0.75 | round }}px; text-align: center; }
  .tskies-newsletter-{{ section.id }} .tskies-newsletter__inner { max-width: {{ section.settings.content_width }}px; margin: 0 auto; padding: 0 1.5rem; }
  .tskies-newsletter-{{ section.id }} .tskies-newsletter__heading { margin: 0 0 1.6rem; text-transform: none; }
  .tskies-newsletter-{{ section.id }} .tskies-newsletter__text { margin: 0 0 2.4rem; font-size: 1.8rem; line-height: 1.8; }
  .tskies-newsletter-{{ section.id }} .tskies-newsletter__row { display: flex; justify-content: center; gap: 2rem; align-items: stretch; }
  .tskies-newsletter-{{ section.id }} .tskies-newsletter__input { flex: 1 1 auto; max-width: 39.7rem; min-height: 6.8rem; padding: 0 2rem; border: 1px solid #8a8a8a; border-radius: 0; background: #fff; color: #1c1d1d; font-size: 1.8rem; box-shadow: none; }
  .tskies-newsletter-{{ section.id }} .tskies-newsletter__input::placeholder { color: #b5b5b5; }
  .tskies-newsletter-{{ section.id }} .tskies-newsletter__button { flex: 0 0 auto; min-height: 6.8rem; padding: 0 1.2rem; border: 0; border-radius: 0; background: {{ section.settings.button_color }}; color: {{ section.settings.button_text_color }}; font-family: inherit; font-size: 1.8rem; font-weight: 500; text-transform: none; cursor: pointer; }
  .tskies-newsletter-{{ section.id }} .tskies-newsletter__button:hover { filter: brightness(0.96); }
  .tskies-newsletter-{{ section.id }} .tskies-newsletter__message { margin: 1.2rem 0 0; font-size: 1.5rem; }
  .tskies-newsletter-{{ section.id }} .tskies-newsletter__message--error { color: #b3261e; }
  @media (max-width: 749px) {
    .tskies-newsletter-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.5 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round }}px; }
    .tskies-newsletter-{{ section.id }} .tskies-newsletter__row { flex-direction: column; gap: 1rem; }
    .tskies-newsletter-{{ section.id }} .tskies-newsletter__input { max-width: none; min-height: 5.6rem; }
    .tskies-newsletter-{{ section.id }} .tskies-newsletter__button { min-height: 5.6rem; padding: 0 2rem; }
  }
{%- endstyle -%}
<div class="tskies-newsletter-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="tskies-newsletter__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="tskies-newsletter__heading h1">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="tskies-newsletter__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- form 'customer', id: 'TskiesNewsletter', class: 'tskies-newsletter__form', novalidate: 'novalidate' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="tskies-newsletter__row">
        <label class="visually-hidden" for="TskiesNewsletter-email-{{ section.id }}">{{ section.settings.placeholder | escape }}</label>
        <input
          id="TskiesNewsletter-email-{{ section.id }}"
          class="tskies-newsletter__input"
          type="email"
          name="contact[email]"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          placeholder="{{ section.settings.placeholder | escape }}"
          value="{{ form.email }}"
          required
          {% if form.errors %}aria-invalid="true" aria-describedby="TskiesNewsletter-error-{{ section.id }}"{% endif %}
        >
        <button type="submit" class="tskies-newsletter__button" name="commit">{{ section.settings.button_label | escape }}</button>
      </div>
      {%- if form.errors -%}
        <p class="tskies-newsletter__message tskies-newsletter__message--error" id="TskiesNewsletter-error-{{ section.id }}" role="alert">
          {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
        </p>
      {%- elsif form.posted_successfully? -%}
        <p class="tskies-newsletter__message" role="status">{{ section.settings.success_message | escape }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>
{% schema %}
{
  "name": "T.Skies newsletter",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Første adgang til ugentlige nyheder" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tilmeld dig vores e-mailliste og få adgang først i køen til vores ugentlige udgivelser af små serier!</p>" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "E-mail" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Spring køen over" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Tak! Du er nu tilmeldt." },
    { "type": "color", "id": "button_color", "label": "Button color", "default": "#ceb498" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "range", "id": "content_width", "min": 400, "max": 900, "step": 20, "unit": "px", "default": 560, "label": "Content width" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24, "label": "Bottom padding" }
  ],
  "presets": [{ "name": "T.Skies newsletter" }]
}
{% endschema %}
