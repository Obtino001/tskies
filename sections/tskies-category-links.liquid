{%- style -%}
  .tskies-catlinks-{{ section.id }} { padding: {{ section.settings.padding_top | times: 0.75 | round }}px 0 {{ section.settings.padding_bottom | times: 0.75 | round }}px; }
  .tskies-catlinks-{{ section.id }} .tskies-catlinks__list { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.6rem 2.4rem; list-style: none; margin: 0; padding: 0; }
  .tskies-catlinks-{{ section.id }} .tskies-catlinks__item { width: {{ section.settings.circle_size }}px; text-align: center; }
  .tskies-catlinks-{{ section.id }} .tskies-catlinks__item a { display: block; color: inherit; text-decoration: none; }
  .tskies-catlinks-{{ section.id }} .tskies-catlinks__image { width: {{ section.settings.circle_size }}px; height: {{ section.settings.circle_size }}px; border-radius: 50%; overflow: hidden; background: rgba(var(--color-foreground), 0.06); margin: 0 auto; }
  .tskies-catlinks-{{ section.id }} .tskies-catlinks__image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tskies-catlinks-{{ section.id }} .tskies-catlinks__label { display: block; margin-top: 0.8rem; font-size: 1.3rem; }
  {%- if section.settings.hide_on_desktop -%}
    @media (min-width: 769px) {
      .tskies-catlinks-{{ section.id }} { display: none !important; }
    }
  {%- endif -%}
  @media (max-width: 768px) {
    .tskies-catlinks-{{ section.id }} { padding-top: 10px; padding-bottom: 10px; }
    .tskies-catlinks-{{ section.id }} .tskies-catlinks__list {
      display: flex !important;
      flex-wrap: nowrap !important;
      justify-content: flex-start !important;
      overflow-x: auto !important;
      -webkit-overflow-scrolling: touch;
      gap: 1.2rem !important;
      padding: 0 1rem !important;
      scrollbar-width: none;
    }
    .tskies-catlinks-{{ section.id }} .tskies-catlinks__list::-webkit-scrollbar { display: none; }
    .tskies-catlinks-{{ section.id }} .tskies-catlinks__item {
      flex: 0 0 auto !important;
      width: auto !important;
      min-width: 6.4rem !important;
    }
    .tskies-catlinks-{{ section.id }} .tskies-catlinks__image {
      width: 60px !important;
      height: 60px !important;
      border-radius: 100% !important;
      border: 2px solid #000000 !important;
      padding: 2px !important;
      box-sizing: border-box !important;
    }
    .tskies-catlinks-{{ section.id }} .tskies-catlinks__label {
      font-size: 1.2rem !important;
      font-weight: 700 !important;
      text-transform: uppercase !important;
      color: #000000 !important;
      margin-top: 5px !important;
    }
  }
{%- endstyle -%}
<div class="tskies-catlinks-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <ul class="tskies-catlinks__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign target = block.settings.collection -%}
        {%- assign label = block.settings.label | default: target.title -%}
        {%- assign img = block.settings.image | default: target.featured_image -%}
        <li class="tskies-catlinks__item" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: target.url | default: routes.collections_url }}">
            <span class="tskies-catlinks__image">
              {%- if img != blank and img.width > 0 -%}
                {{ img | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 300', alt: label }}
              {%- else -%}
                {%- assign label_clean = label | downcase | strip -%}
                {%- capture circle_file -%}
                  {%- case label_clean -%}
                    {%- when 'best sellers' -%}category_circle_best_sellers.png
                    {%- when 'gallery' -%}category_circle_gallery.png
                    {%- when 'rings' -%}category_circle_rings.jpg
                    {%- when 'bracelets' -%}category_circle_bracelets.png
                    {%- when 'necklaces' -%}category_circle_necklaces.png
                    {%- when 'earrings' -%}category_circle_earrings.jpg
                  {%- endcase -%}
                {%- endcapture -%}
                {%- assign circle_file = circle_file | strip -%}
                {%- if circle_file != blank -%}
                  <img
                    src="{{ circle_file | asset_url }}"
                    alt="{{ label | escape }}"
                    loading="lazy"
                    width="150"
                    height="150"
                    style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;"
                  >
                {%- endif -%}
              {%- endif -%}
            </span>
            <span class="tskies-catlinks__label">{{ label | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
{% schema %}
{
  "name": "T.Skies category links",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop (show only on mobile/tablet)", "default": true },
    { "type": "range", "id": "circle_size", "min": 60, "max": 160, "step": 4, "unit": "px", "default": 96, "label": "Circle size (desktop)" },
    { "type": "range", "id": "circle_size_mobile", "min": 48, "max": 120, "step": 4, "unit": "px", "default": 64, "label": "Circle size (mobile)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24, "label": "Bottom padding" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Category link",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection title." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image." },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Overrides the collection link." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "T.Skies category links", "blocks": [{ "type": "link" }, { "type": "link" }, { "type": "link" }, { "type": "link" }, { "type": "link" }, { "type": "link" }] }
  ]
}
{% endschema %}
