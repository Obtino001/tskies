{%- style -%}
  .tskies-story-{{ section.id }} { padding: {{ section.settings.padding_top | times: 0.75 | round }}px 0 {{ section.settings.padding_bottom | times: 0.75 | round }}px; }
  .tskies-story-{{ section.id }} .tskies-story__row { display: flex; flex-direction: column; gap: 3rem; align-items: center; }
  .tskies-story-{{ section.id }} .tskies-story__text { width: 100%; text-align: {{ section.settings.text_alignment }}; }
  .tskies-story-{{ section.id }} .tskies-story__eyebrow { margin: 0 0 0.5rem; font-size: 1.36rem; letter-spacing: 0.2em; text-transform: uppercase; color: #1c1d1d; }
  .tskies-story-{{ section.id }} .tskies-story__heading { margin: 0 0 1.6rem; font-size: 2.8rem; line-height: 1.2; text-transform: none; }
  .tskies-story-{{ section.id }} .tskies-story__text .rte { font-size: 1.8rem; line-height: 1.7; letter-spacing: 0; color: #1c1d1d; }
  .tskies-story-{{ section.id }} .tskies-story__text .rte p { margin: 0 0 1.4rem; }
  .tskies-story-{{ section.id }} .tskies-story__images { display: grid; grid-template-columns: repeat({{ section.blocks | where: 'type', 'image' | size | at_least: 1 }}, minmax(0, 1fr)); gap: 2rem; width: 100%; }
  .tskies-story-{{ section.id }} .tskies-story__images img { display: block; width: 100%; height: auto; }
  .tskies-story-{{ section.id }} .tskies-story__images--overlap { display: flex; align-items: flex-start; gap: 0; }
  .tskies-story-{{ section.id }} .tskies-story__images--overlap > div { flex: 0 0 auto; }
  .tskies-story-{{ section.id }} .tskies-story__images--overlap > div:nth-child(1) { position: relative; z-index: 1; width: 52.7%; margin-top: 13.9%; }
  .tskies-story-{{ section.id }} .tskies-story__images--overlap > div:nth-child(2) { position: relative; z-index: 2; width: 57.5%; margin-left: -10.2%; }
  .tskies-story-{{ section.id }} .tskies-story__images--overlap > div:nth-child(n+3) { display: none; }
  @media (max-width: 749px) {
    .tskies-story-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.5 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round }}px; }
    .tskies-story-{{ section.id }} .tskies-story__row { padding: 0 1.5rem; }
  }
  @media (min-width: 750px) {
    .tskies-story-{{ section.id }} .tskies-story__row { flex-direction: row; justify-content: space-between; gap: 6rem; margin: 0 6%; }
    .tskies-story-{{ section.id }} .tskies-story__text { flex: 0 1 43%; min-width: 43%; order: {% if section.settings.text_position == 'right' %}2{% else %}1{% endif %}; }
    .tskies-story-{{ section.id }} .tskies-story__images { flex: 0 1 57%; order: {% if section.settings.text_position == 'right' %}1{% else %}2{% endif %}; }
  }
{%- endstyle -%}
<div class="tskies-story-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="tskies-story__row">
      <div class="tskies-story__text">
        {%- if section.settings.eyebrow != blank -%}<p class="tskies-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="tskies-story__heading h1">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.root_url }}" class="button{% if section.settings.button_style_secondary %} button--secondary{% endif %}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
      <div class="tskies-story__images{% if section.settings.image_layout == 'overlap' %} tskies-story__images--overlap{% endif %}">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            {%- capture picture -%}
              {%- if block.settings.image != blank and block.settings.image.width > 0 -%}
                {{ block.settings.image | image_url: width: 1080 | image_tag: loading: 'lazy', widths: '360, 540, 750, 1080', sizes: '(min-width: 750px) 28vw, 45vw', alt: block.settings.image.alt }}
              {%- else -%}
                {%- capture story_img -%}
                  {%- if forloop.index == 1 -%}brand_story_studio_1.webp{%- else -%}brand_story_studio_2.webp{%- endif -%}
                {%- endcapture -%}
                <img
                  src="{{ story_img | strip | asset_url }}"
                  alt="T.Skies Studio"
                  loading="lazy"
                  width="800"
                  height="1000"
                  style="width: 100%; height: 100%; object-fit: cover;"
                >
              {%- endif -%}
            {%- endcapture -%}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ picture }}</a>{%- else -%}{{ picture }}{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "T.Skies story",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Håndlavet" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Fyldt med ånd." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "button_style_secondary", "label": "Outline button", "default": false },
    { "type": "select", "id": "image_layout", "label": "Image layout", "options": [{ "value": "overlap", "label": "Overlapping" }, { "value": "side_by_side", "label": "Side by side" }], "default": "overlap" },
    { "type": "select", "id": "text_position", "label": "Text position (desktop)", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36, "label": "Bottom padding" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "T.Skies story", "blocks": [{ "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
