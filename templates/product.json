        "trust_badges": {
          "type": "trust_badges",
          "settings": {}
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "shipping_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Forsendelse & Returnering",
            "icon": "return",
            "page": "shipping-returns"
          }
        },
        "care_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Pleje af smykker",
            "icon": "none",
            "page": "jewelry-care"
          }
        }
      },
      "block_order": [
        "title",
        "rating",
        "price",
        "variant_picker",
        "inventory",
        "bundle_and_save",
        "buy_buttons",
