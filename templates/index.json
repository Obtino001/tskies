          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>T.Skies is a turquoise jewelry studio and gallery in Albuquerque, New Mexico. We sell two kinds of work: our own Southwest jewelry designs, and Native American jewelry by named artists, sold under the maker\u00e2\u20ac\u2122s name. Ask about any stone and we\u00e2\u20ac\u2122ll tell you whether it\u00e2\u20ac\u2122s natural or stabilized.</p>"
          }
        },
