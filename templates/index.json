      "settings": {
        "eyebrow": "Crafted by Hand",
        "heading": "Infused with Spirit.",
        "text": "<p>In the Southwest, the tradition of making, wearing and trading real <a href=\"shopify://collections/turquoise\">turquoise jewelry</a> is embedded in our way of life. At T.Skies, we honor the artistry and craftsmanship of this timeless art form through which so much culture and storytelling can be shared. At T.Skies, you’ll find fine Southwest jewelry handcrafted with high-quality, responsibly-sourced materials. We create pieces that feel like you.</p>",
        "button_label": "Learn More About Us",
        "button_link": "shopify://pages/about-us",
        "button_style_secondary": false,
        "text_position": "left",
        "text_alignment": "left",
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
