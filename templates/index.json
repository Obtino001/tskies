          "settings": {
            "heading": "Real Turquoise Jewelry & Native American Jewelry",
            "heading_size": "h2"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>T.Skies is a turquoise jewelry studio and gallery in Albuquerque, New Mexico. We sell two kinds of work: our own Southwest jewelry designs, and Native American jewelry by named artists, sold under the maker’s name. Ask about any stone and we’ll tell you whether it’s natural or stabilized.</p>"
          }
        },
        "links": {
          "type": "text",
          "settings": {
            "text": "<p><a href=\"shopify://collections/turquoise\">Turquoise Jewelry</a> &nbsp; <a href=\"shopify://collections/native-american-jewelry\">Native American Jewelry</a></p>"
          }
